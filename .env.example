# GROQ_API_KEY: Chave de API gratuita da Groq (obtenha gratuitamente em https://console.groq.com/keys)
# No Cloudflare Pages: adicione GROQ_API_KEY no painel de Environment Variables do projeto.
GROQ_API_KEY="gsk_seu_token_aqui"

# Porta local do servidor
PORT=3000

# URL do site
APP_URL="https://optimafy.net"
